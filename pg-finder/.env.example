# Copy to .env and edit.  cp .env.example .env

PORT=3000
NODE_ENV=development
# Public address of the site, used in password-reset links
APP_URL=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pg_finder

# Long random string used to sign login cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway, ...)
TRUST_PROXY=0

# Optional SMTP for real password-reset emails. If SMTP_HOST is empty,
# emails and OTP codes are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PG Finder <no-reply@pgfinder.example>"
